# ---------------------------------------------------------------------------
# Gathered Platform — environment configuration
# Copy to .env for local development. In production set these in Coolify.
# Never commit real secrets. (Spec 12.3)
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Full public URL of the app. Used to build public event links and private
# guest RSVP links in emails. Must include the scheme, no trailing slash.
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gathered

# Secret used to sign CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value

# IANA timezone applied to newly created events. Organisers may override
# per event. (Spec 17 Q6)
DEFAULT_TIMEZONE=Europe/London

# ISO 4217 currency used to display event deposit and balance amounts.
# Applies to the whole application, not per event.
DEFAULT_CURRENCY=GBP

# --- Legal / operator identity ---------------------------------------------
# Who runs this deployment. /privacy and /terms name this organisation as the
# data controller, so it cannot be hardcoded in the app: every install has a
# different operator. Until the first two are set, both pages show a visible
# "not configured" warning.
LEGAL_ENTITY_NAME=
# Where data protection requests should go. Must be a real, monitored address:
# it is the route by which someone exercises their GDPR rights.
LEGAL_CONTACT_EMAIL=
# Postal address of the operator. Multi-line is fine.
LEGAL_POSTAL_ADDRESS=
# Country whose supervisory authority and courts apply, e.g. "Ireland".
LEGAL_JURISDICTION=
# Optional. Overrides the retention paragraph in the privacy notice. Leave
# blank unless you have a policy you actually enforce — Gathered does not
# delete anything on a timer, and claiming otherwise would be untrue.
LEGAL_RETENTION_STATEMENT=

# --- Email (Spec 6.5, 12.4) ------------------------------------------------
# Which adapter to use: console | smtp | resend
# "console" logs the message instead of sending — the default for development.
EMAIL_DRIVER=console

# Address invitation and password reset emails are sent from.
EMAIL_FROM="Gathered <no-reply@example.com>"

# Required when EMAIL_DRIVER=resend
RESEND_API_KEY=

# Required when EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Object storage (Spec 8.7, 12.5) ---------------------------------------
# Which driver to use: local | s3
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=local.
# In production this MUST be a persistent volume mounted into the container,
# otherwise uploads are lost on every deploy.
LOCAL_STORAGE_PATH=./storage/uploads

# Required when STORAGE_DRIVER=s3 (works with AWS S3, MinIO, Backblaze B2,
# Cloudflare R2, Hetzner Object Storage, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most S3-compatible providers other than AWS need path-style addressing.
S3_FORCE_PATH_STYLE=true
# Optional public base URL if the bucket is fronted by a CDN. When unset,
# images are streamed through the app.
S3_PUBLIC_URL=
