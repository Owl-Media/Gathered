{
  "name": "gathered",
  "version": "0.2.1",
  "description": "A deliberately private RSVP platform for small events. Every guest gets their own link; nobody gets a list of who else was invited.",
  "license": "MIT",
  "author": "Owl Media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owl-media/gathered.git"
  },
  "homepage": "https://github.com/owl-media/gathered#readme",
  "bugs": {
    "url": "https://github.com/owl-media/gathered/issues"
  },
  "keywords": [
    "rsvp",
    "events",
    "invitations",
    "self-hosted",
    "nextjs",
    "privacy"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/tsx src/db/migrate.ts",
    "db:studio": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit studio",
    "db:seed-superadmin": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/seed-superadmin.ts",
    "db:seed-demo": "node --env-file-if-exists=.env node_modules/.bin/tsx --tsconfig tsconfig.scripts.json scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.6.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
